{
  "name": "entregado",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev --filter=@entregado/backend --filter=web --filter=business",
    "dev:backend": "turbo dev --filter=@entregado/backend",
    "dev:web": "pnpm --filter web dev",
    "dev:business": "pnpm --filter business dev",
    "lint": "turbo lint",
    "format": "turbo format",
    "format:check": "turbo format:check",
    "typecheck": "turbo typecheck",
    "test": "turbo test"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "prettier": "^3.8.3",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "turbo": "^2.9.18",
    "typescript": "~6",
    "vercel": "^59.11.7"
  },
  "packageManager": "pnpm@10.33.4",
  "engines": {
    "node": ">=22.12.0"
  }
}
