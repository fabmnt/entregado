---
import { getBusinessAppUrl } from "../lib/businesses"

const businessAppUrl = getBusinessAppUrl()

const focusRing =
  "focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-4 focus-visible:ring-offset-background focus-visible:outline-none"
---

<header class="site-header sticky top-0 z-40 py-4 backdrop-blur-md md:py-5">
  <div
    class="mx-auto flex w-full max-w-7xl items-center justify-between gap-8 px-5 md:px-10"
  >
    <a
      href="/"
      class:list={[
        "site-wordmark font-display text-wordmark text-[1.9rem] leading-none font-medium tracking-[-0.02em] md:text-[2.4rem]",
        focusRing,
      ]}
    >
      Entregado
    </a>
    <nav aria-label="Principal">
      <ul class="flex items-center gap-5 md:gap-8">
        <li>
          <a
            href="#businesses"
            class:list={[
              "inline-block py-3 text-sm text-muted-foreground transition-colors hover:text-foreground",
              focusRing,
            ]}
          >
            Negocios
          </a>
        </li>
        <li>
          <a
            href={`${businessAppUrl}/login`}
            class:list={[
              "inline-flex items-center rounded-full border border-primary/25 px-4 py-2 text-sm text-primary transition-colors hover:border-primary hover:bg-primary hover:text-primary-foreground",
              focusRing,
            ]}
          >
            Entrar
          </a>
        </li>
      </ul>
    </nav>
  </div>
</header>
