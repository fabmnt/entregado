---
const year = new Date().getFullYear()
---

<footer class="mt-auto px-6 py-12 md:px-12 lg:px-16">
  <div class="h-px bg-border"></div>
  <div
    class="flex flex-col gap-8 pt-10 md:flex-row md:items-end md:justify-between"
  >
    <div class="flex flex-col gap-3">
      <p class="font-serif text-2xl tracking-wide">Entregado</p>
      <p class="max-w-sm text-sm leading-relaxed text-muted-foreground">
        Una app de ventas y pedidos para cada negocio.
      </p>
    </div>
    <div class="flex flex-col gap-3 md:items-end">
      <a
        href="#businesses"
        class="text-sm text-muted-foreground transition-colors hover:text-foreground focus-visible:ring-2 focus-visible:ring-ring/60 focus-visible:ring-offset-2 focus-visible:outline-none"
      >
        Negocios
      </a>
      <p class="text-sm text-muted-foreground">© {year}</p>
    </div>
  </div>
</footer>
