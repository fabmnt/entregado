# Convex writes these during `convex dev`
CONVEX_DEPLOYMENT=
PUBLIC_CONVEX_URL=
CONVEX_URL=

# Same as PUBLIC_CONVEX_URL but ending in .convex.site
PUBLIC_CONVEX_SITE_URL=

# App origin used by Better Auth cookies
SITE_URL=http://localhost:4321

# Comma-separated emails that sign in as general admins.
# Everyone else with an account is a business owner.
# Set this on the Convex deployment, not only here:
#   pnpm exec convex env set GENERAL_ADMIN_EMAILS you@example.com
# GENERAL_ADMIN_EMAILS=
