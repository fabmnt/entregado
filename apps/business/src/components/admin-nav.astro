---
interface Props {
  slug: string
  name: string
  current: "home" | "profile" | "products" | "sales" | "riders"
}

const { slug, name, current } = Astro.props

const links = [
  { href: `/admin/${slug}`, id: "home", label: "Inicio" },
  { href: `/admin/${slug}/sales`, id: "sales", label: "Ventas" },
  { href: `/admin/${slug}/products`, id: "products", label: "Productos" },
  { href: `/admin/${slug}/riders`, id: "riders", label: "Repartidores" },
  { href: `/admin/${slug}/profile`, id: "profile", label: "Negocio" },
] as const
---

<header class="flex flex-col gap-3 border-b border-border pb-4">
  <div class="flex items-start justify-between gap-4">
    <div class="flex flex-col gap-1">
      <a
        href="/admin"
        class="text-sm text-muted-foreground underline-offset-4 hover:underline"
      >
        Negocios
      </a>
      <h1 class="text-xl font-medium">{name}</h1>
    </div>
    <a
      href={`/${slug}`}
      class="text-sm text-muted-foreground underline-offset-4 hover:underline"
    >
      Ver tienda
    </a>
  </div>
  <nav aria-label="Panel del negocio">
    <ul class="flex flex-wrap gap-4">
      {
        links.map((link) => (
          <li>
            <a
              href={link.href}
              aria-current={current === link.id ? "page" : undefined}
              class:list={[
                "text-sm underline-offset-4 hover:underline",
                current === link.id
                  ? "font-medium text-foreground"
                  : "text-muted-foreground",
              ]}
            >
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>
