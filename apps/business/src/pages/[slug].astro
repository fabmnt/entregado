---
import { nicaraguaLocalDigits } from "@entregado/utils"
import ProductCard from "../components/product-card.astro"
import Layout from "../layouts/main.astro"
import { getStorefront } from "../lib/businesses"
import { getWebAppUrl } from "../lib/web-url"
import { addCartItem, cartUnitCount, readCart, writeCart } from "../lib/cart"
import { businessInquiryUrl } from "../lib/whatsapp"

export const prerender = false

const slug = Astro.params.slug

if (!slug) {
  return Astro.rewrite("/404")
}

const store = await getStorefront(slug)
if (!store) {
  return Astro.rewrite("/404")
}

const { business, products } = store
const whatsapp = business.whatsapp
const cart = readCart(Astro.cookies, slug)

if (Astro.request.method === "POST") {
  const form = await Astro.request.formData()
  const productId = String(form.get("productId") ?? "")

  if (
    String(form.get("intent") ?? "") === "add" &&
    products.some((product) => product.id === productId)
  ) {
    writeCart(Astro.cookies, slug, addCartItem(cart, productId))
  }

  // Back to the product card so the page does not jump to the top.
  return Astro.redirect(`/${business.slug}#product-${productId}`, 303)
}

const cartCount = cartUnitCount(cart)

// The hero color tells the kind of business, like the directory cards.
const KIND_TONES = { food: "bg-blush", pharmacy: "bg-mint" } as const
const KIND_LABELS = { food: "Comida", pharmacy: "Farmacia" } as const

// Keeps "8:00 p. m." on one line instead of splitting it across two.
function keepTimeTogether(text: string | undefined): string {
  return (text ?? "").replace(/([ap])\. m\./g, "$1.\u00a0m.")
}

const contactItems = [
  { label: "Horario", value: keepTimeTogether(business.hours) },
  { label: "Zona de entrega", value: keepTimeTogether(business.scope) },
  { label: "Dirección", value: keepTimeTogether(business.address) },
].filter((item) => item.value !== "")
const hasContact =
  Boolean(whatsapp) || Boolean(business.phone) || contactItems.length > 0

const webUrl = getWebAppUrl()

const focusRing =
  "focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-4 focus-visible:ring-offset-background focus-visible:outline-none"
const year = new Date().getFullYear()
---

<Layout title={business.name} description={business.description}>
  <div class="storefront min-h-svh bg-background text-foreground">
    <header
      class="sticky top-0 z-40 border-b border-border bg-background/90 backdrop-blur-md"
    >
      <div
        class="mx-auto flex w-full max-w-7xl items-center justify-between gap-4 px-5 py-4 md:px-10 md:py-5"
      >
        <div class="flex min-w-0 items-center gap-4 md:gap-6">
          <a
            href={`/${business.slug}`}
            class:list={[
              "font-display min-w-0 truncate text-2xl leading-none font-semibold tracking-[-0.02em] text-primary md:text-[2rem]",
              focusRing,
            ]}
          >
            {business.name}
          </a>
          <a
            href={webUrl}
            class:list={[
              "shrink-0 text-sm text-muted-foreground transition-colors hover:text-foreground",
              focusRing,
            ]}
          >
            Entregado
          </a>
        </div>
        <div class="flex shrink-0 items-center gap-2 md:gap-3">
          {
            hasContact ? (
              <a
                href="#contact"
                class:list={[
                  "rounded-full border border-primary/25 px-4 py-2 text-sm text-primary transition-colors hover:border-primary",
                  focusRing,
                ]}
              >
                Contacto
              </a>
            ) : null
          }
          {
            cartCount > 0 ? (
              <a
                href={`/${business.slug}/cart`}
                class:list={[
                  "rounded-full bg-primary px-5 py-2.5 text-sm font-medium text-primary-foreground transition-colors hover:bg-primary/90",
                  focusRing,
                ]}
              >
                Ver pedido · {cartCount}
              </a>
            ) : null
          }
        </div>
      </div>
    </header>

    <main>
      <section
        class="mx-auto w-full max-w-7xl px-3 pt-4 md:px-6"
        aria-labelledby="store-heading"
      >
        <div
          class:list={[
            "grid gap-14 overflow-hidden rounded-[2.5rem] px-5 pt-12 pb-14 md:px-12 md:pt-16 lg:gap-16 lg:px-16 lg:py-20",
            KIND_TONES[business.kind],
            business.logoUrl && "lg:grid-cols-[1.1fr_1fr] lg:items-center",
          ]}
        >
          <div class="flex flex-col gap-7 md:gap-8">
            <p
              class="w-fit rounded-full bg-primary px-3 py-1 text-xs font-medium text-primary-foreground"
            >
              {KIND_LABELS[business.kind]}
            </p>
            <h1
              id="store-heading"
              class="font-display text-[2.6rem] leading-[1.02] font-semibold tracking-[-0.025em] text-balance text-primary sm:text-6xl lg:text-[4.2rem]"
            >
              {business.name}
            </h1>
            <p
              class="max-w-md text-lg leading-relaxed text-pretty text-foreground/75"
            >
              {business.description}
            </p>
            {
              business.advantages ? (
                <p class="flex max-w-md items-start gap-3 text-sm leading-relaxed text-foreground/75">
                  <span
                    class="bg-brass mt-2 size-2 shrink-0 rotate-45"
                    aria-hidden="true"
                  />
                  {business.advantages}
                </p>
              ) : null
            }
            <div class="flex flex-wrap items-center gap-x-8 gap-y-3">
              <a
                href="#products"
                class:list={[
                  "inline-flex items-center justify-center rounded-full bg-primary px-8 py-4 text-base font-medium text-primary-foreground shadow-[0_12px_30px_-12px_rgb(23_64_47/0.6)] transition-colors hover:bg-primary/90",
                  focusRing,
                ]}
              >
                Ver productos
              </a>
              {
                whatsapp ? (
                  <a
                    href={businessInquiryUrl(business.name, whatsapp)}
                    target="_blank"
                    rel="noopener noreferrer"
                    class:list={[
                      "decoration-brass inline-block py-3 text-sm text-foreground/75 underline decoration-2 underline-offset-[6px] transition-colors hover:text-foreground",
                      focusRing,
                    ]}
                  >
                    Consultar por WhatsApp
                  </a>
                ) : null
              }
            </div>
          </div>

          {
            business.logoUrl ? (
              <div class="relative mx-auto w-full max-w-[17rem] sm:max-w-md">
                <div
                  class="border-brass/70 pointer-events-none absolute -inset-x-3 -top-3 -bottom-3 rounded-t-full border-2"
                  aria-hidden="true"
                />
                <div class="relative overflow-hidden rounded-t-full bg-background/60">
                  <img
                    src={business.logoUrl}
                    alt={`Logo de ${business.name}`}
                    width="1200"
                    height="1500"
                    fetchpriority="high"
                    class="aspect-[4/5] w-full object-cover"
                  />
                </div>
              </div>
            ) : null
          }
        </div>
      </section>

      <section
        id="products"
        class="mx-auto w-full max-w-7xl scroll-mt-24 px-5 pt-16 pb-24 md:px-10 md:pt-24 md:pb-28"
        aria-labelledby="products-heading"
      >
        <div class="flex max-w-xl flex-col gap-4">
          <h2
            id="products-heading"
            class="font-display text-4xl font-semibold tracking-[-0.02em] text-primary md:text-6xl"
          >
            Productos
          </h2>
          {
            business.productPitch ? (
              <p class="text-base leading-relaxed text-foreground/75">
                {business.productPitch}
              </p>
            ) : null
          }
        </div>

        {
          products.length === 0 ? (
            <p class="bg-sage mt-12 max-w-md rounded-[2rem] p-6 text-sm leading-relaxed text-foreground/75">
              Aún no hay productos publicados.
            </p>
          ) : (
            <ul class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3 lg:gap-8">
              {products.map((product) => (
                <ProductCard product={product} />
              ))}
            </ul>
          )
        }
      </section>

      {
        hasContact ? (
          <section
            id="contact"
            class="scroll-mt-20 bg-primary text-primary-foreground"
            aria-labelledby="contact-heading"
          >
            <div class="mx-auto w-full max-w-7xl px-5 py-20 md:px-10 md:py-28">
              <div class="border-brass/70 rounded-t-[10rem] border-4 border-double px-6 pt-16 pb-12 md:rounded-t-[16rem] md:px-14 md:pt-24 md:pb-16">
                <div class="flex flex-col items-center gap-5 text-center">
                  <h2
                    id="contact-heading"
                    class="font-display text-4xl font-semibold tracking-[-0.02em] md:text-6xl"
                  >
                    Contacto
                  </h2>
                  <div class="flex items-center gap-3" aria-hidden="true">
                    <span class="bg-brass h-px w-12" />
                    <span class="bg-brass size-2 rotate-45" />
                    <span class="bg-brass h-px w-12" />
                  </div>
                </div>

                {whatsapp ? (
                  <div class="mt-10 flex justify-center">
                    <a
                      href={businessInquiryUrl(business.name, whatsapp)}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="bg-butter hover:bg-butter/90 focus-visible:ring-butter inline-flex items-center justify-center rounded-full px-8 py-4 text-base font-medium text-primary transition-colors focus-visible:ring-2 focus-visible:ring-offset-4 focus-visible:ring-offset-primary focus-visible:outline-none"
                    >
                      Consultar por WhatsApp
                    </a>
                  </div>
                ) : null}

                <dl class="mt-14 grid gap-10 text-center sm:grid-cols-2 md:mt-16 lg:grid-cols-[repeat(auto-fit,minmax(12rem,1fr))]">
                  {contactItems.map((item) => (
                    <div class="flex flex-col gap-2">
                      <dt class="text-sm text-primary-foreground/75">
                        {item.label}
                      </dt>
                      <dd class="font-display text-xl leading-snug">
                        {item.value}
                      </dd>
                    </div>
                  ))}
                  {business.phone ? (
                    <div class="flex flex-col gap-2">
                      <dt class="text-sm text-primary-foreground/75">
                        Teléfono
                      </dt>
                      <dd class="font-display text-xl leading-snug lining-nums">
                        <a
                          href={`tel:${business.phone}`}
                          class="decoration-brass focus-visible:ring-butter underline decoration-2 underline-offset-[6px] focus-visible:ring-2 focus-visible:ring-offset-4 focus-visible:ring-offset-primary focus-visible:outline-none"
                        >
                          {nicaraguaLocalDigits(business.phone)}
                        </a>
                      </dd>
                    </div>
                  ) : null}
                </dl>
              </div>
            </div>
          </section>
        ) : null
      }
    </main>

    <footer class="mx-auto w-full max-w-7xl px-5 md:px-10">
      <div
        class="flex flex-col gap-2 py-10 text-sm text-muted-foreground sm:flex-row sm:items-center sm:justify-between"
      >
        <p class="font-display text-xl font-semibold text-primary">
          {business.name}
        </p>
        <p>© {year} · Tienda en Entregado</p>
      </div>
    </footer>
  </div>
</Layout>
