---
import {
  Field,
  FieldDescription,
  FieldError,
  FieldGroup,
  FieldLabel,
} from "@workspace/ui/components/field"
import { Input } from "@workspace/ui/components/input"
import AuthShell from "../components/auth-shell.astro"
import {
  authErrorMessage,
  fieldErrorsFromZod,
  signUpSchema,
  type AuthFieldErrors,
} from "../lib/auth-forms"
import { postConvexAuth, redirectWithCookies } from "../lib/auth-server"

let name = ""
let email = ""
let fieldErrors: AuthFieldErrors = {}
let formError = ""

if (Astro.request.method === "POST") {
  const form = await Astro.request.formData()
  name = String(form.get("name") ?? "")
  email = String(form.get("email") ?? "")
  const parsed = signUpSchema.safeParse({
    name,
    email,
    password: String(form.get("password") ?? ""),
  })

  if (!parsed.success) {
    formError = "Revisa los datos de la cuenta"
    fieldErrors = fieldErrorsFromZod(parsed.error)
  } else {
    const response = await postConvexAuth(
      Astro.request,
      "/api/auth/sign-up/email",
      parsed.data
    )
    if (response.ok) {
      return redirectWithCookies("/admin", response)
    }
    formError = await authErrorMessage(response)
  }
}
---

<AuthShell
  title="Registro | Entregado"
  heading="Crear cuenta"
  description="La primera cuenta que se registre es admin general. Las siguientes son de dueño de negocio."
>
  <form method="post" class="flex flex-col gap-6">
    {
      formError ? (
        <p class="text-sm text-destructive" role="alert">
          {formError}
        </p>
      ) : null
    }
    <FieldGroup>
      <Field data-invalid={fieldErrors.name ? true : undefined}>
        <FieldLabel htmlFor="name">Nombre</FieldLabel>
        <Input
          id="name"
          name="name"
          autoComplete="name"
          defaultValue={name}
          required
          aria-invalid={fieldErrors.name ? true : undefined}
          aria-describedby={fieldErrors.name ? "name-error" : undefined}
        />
        {
          fieldErrors.name ? (
            <FieldError id="name-error">{fieldErrors.name}</FieldError>
          ) : null
        }
      </Field>
      <Field data-invalid={fieldErrors.email ? true : undefined}>
        <FieldLabel htmlFor="email">Correo</FieldLabel>
        <Input
          id="email"
          name="email"
          type="email"
          autoComplete="email"
          defaultValue={email}
          required
          aria-invalid={fieldErrors.email ? true : undefined}
          aria-describedby={fieldErrors.email ? "email-error" : undefined}
        />
        {
          fieldErrors.email ? (
            <FieldError id="email-error">{fieldErrors.email}</FieldError>
          ) : null
        }
      </Field>
      <Field data-invalid={fieldErrors.password ? true : undefined}>
        <FieldLabel htmlFor="password">Contraseña</FieldLabel>
        <Input
          id="password"
          name="password"
          type="password"
          autoComplete="new-password"
          required
          aria-invalid={fieldErrors.password ? true : undefined}
          aria-describedby={fieldErrors.password ? "password-error" : undefined}
        />
        <FieldDescription>Mínimo 8 caracteres.</FieldDescription>
        {
          fieldErrors.password ? (
            <FieldError id="password-error">{fieldErrors.password}</FieldError>
          ) : null
        }
      </Field>
    </FieldGroup>
    <button
      class="focus-visible:ring-offset-sage inline-flex w-full items-center justify-center rounded-full bg-primary px-8 py-4 text-base font-medium text-primary-foreground transition-colors hover:bg-primary/90 focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-4 focus-visible:outline-none"
      type="submit">Crear cuenta</button
    >
  </form>
  <Fragment slot="footer">
    ¿Ya tienes cuenta?{" "}
    <a
      class="decoration-brass text-primary underline decoration-2 underline-offset-[6px]"
      href="/login">Entrar</a
    >
  </Fragment>
</AuthShell>
