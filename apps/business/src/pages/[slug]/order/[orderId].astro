---
import type { Id } from "@entregado/backend"
import { formatCordoba } from "@entregado/utils"
import Layout from "../../../layouts/main.astro"
import { getStorefront } from "../../../lib/businesses"
import {
  fulfillmentLabel,
  getPublicOrder,
  orderStatusLabel,
} from "../../../lib/orders"

export const prerender = false

const slug = Astro.params.slug
const orderIdParam = Astro.params.orderId

if (!slug || !orderIdParam) {
  return Astro.rewrite("/404")
}

const store = await getStorefront(slug)
const order = await getPublicOrder(slug, orderIdParam as Id<"orders">)

if (!store || !order) {
  return Astro.rewrite("/404")
}
---

<Layout title={`Pedido | ${store.business.name}`}>
  <main class="mx-auto flex min-h-svh w-full max-w-lg flex-col gap-8 p-6">
    <header class="flex flex-col gap-2">
      <a
        href={`/${slug}`}
        class="text-sm text-muted-foreground underline-offset-4 hover:underline"
      >
        {store.business.name}
      </a>
      <h1 class="text-xl font-medium">Pedido recibido</h1>
      <p class="text-sm text-muted-foreground">
        El negocio ya tiene tu pedido. No hace falta crear una cuenta.
      </p>
    </header>

    <dl class="flex flex-col gap-3 text-sm">
      <div class="flex flex-col gap-1">
        <dt class="text-muted-foreground">Productos</dt>
        <dd>
          <ul class="flex flex-col gap-1">
            {
              order.items.map((item) => (
                <li class="flex justify-between gap-4">
                  <span>
                    {item.quantity} × {item.productName}
                  </span>
                  <span class="text-muted-foreground">
                    {formatCordoba(item.unitPrice)} c/u
                  </span>
                </li>
              ))
            }
          </ul>
        </dd>
      </div>
      <div class="flex flex-col gap-0.5">
        <dt class="text-muted-foreground">Total</dt>
        <dd class="font-medium">{formatCordoba(order.totalPrice)}</dd>
      </div>
      <div class="flex flex-col gap-0.5">
        <dt class="text-muted-foreground">Entrega</dt>
        <dd>{fulfillmentLabel(order.fulfillment)}</dd>
      </div>
      <div class="flex flex-col gap-0.5">
        <dt class="text-muted-foreground">Estado</dt>
        <dd>{orderStatusLabel(order.status)}</dd>
      </div>
      <div class="flex flex-col gap-0.5">
        <dt class="text-muted-foreground">Nombre</dt>
        <dd>{order.buyerName}</dd>
      </div>
      <div class="flex flex-col gap-0.5">
        <dt class="text-muted-foreground">Teléfono</dt>
        <dd>{order.buyerPhone}</dd>
      </div>
    </dl>
  </main>
</Layout>
