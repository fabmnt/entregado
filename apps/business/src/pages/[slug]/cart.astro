---
import {
  Field,
  FieldDescription,
  FieldError,
  FieldGroup,
  FieldLabel,
} from "@workspace/ui/components/field"
import { Input } from "@workspace/ui/components/input"
import {
  NativeSelect,
  NativeSelectOption,
} from "@workspace/ui/components/native-select"
import { Textarea } from "@workspace/ui/components/textarea"
import { formatCordoba } from "@entregado/utils"
import Layout from "../../layouts/main.astro"
import { getWebAppUrl } from "../../lib/web-url"
import { fieldErrorsFromZod, getStorefront } from "../../lib/businesses"
import {
  cartItemSchema,
  clearCart,
  readCart,
  removeCartItem,
  setCartItemQuantity,
  toCartLines,
  writeCart,
} from "../../lib/cart"
import {
  checkoutSchema,
  createOrder,
  type CheckoutFieldErrors,
} from "../../lib/orders"

export const prerender = false

const slug = Astro.params.slug

if (!slug) {
  return Astro.rewrite("/404")
}

const store = await getStorefront(slug)
if (!store) {
  return Astro.rewrite("/404")
}

const webUrl = getWebAppUrl()
const cart = readCart(Astro.cookies, slug)

const lines = toCartLines(cart, store.products)
const droppedProducts = lines.length !== cart.length

// Keep the cookie in sync with the catalog so a hidden or deleted product
// never blocks checkout.
if (droppedProducts) {
  writeCart(
    Astro.cookies,
    slug,
    lines.map((line) => ({
      productId: line.productId,
      quantity: line.quantity,
    }))
  )
}

const unitCount = lines.reduce((sum, line) => sum + line.quantity, 0)
const total = lines.reduce((sum, line) => sum + line.lineTotal, 0)
const canDeliver =
  lines.length > 0 && lines.every((line) => line.supportsDelivery)

let formValues = {
  buyerName: "",
  buyerPhone: "",
  fulfillment: canDeliver ? "delivery" : "pickup",
  paymentMethod: "cash_on_delivery",
  buyerLocation: "",
}
let fieldErrors: CheckoutFieldErrors = {}
let formError = ""

if (Astro.request.method === "POST") {
  const form = await Astro.request.formData()
  const intent = String(form.get("intent") ?? "")

  if (intent === "update") {
    const parsed = cartItemSchema.safeParse({
      productId: form.get("productId"),
      quantity: form.get("quantity"),
    })
    if (parsed.success) {
      writeCart(
        Astro.cookies,
        slug,
        setCartItemQuantity(cart, parsed.data.productId, parsed.data.quantity)
      )
    }
    return Astro.redirect(`/${slug}/cart`, 303)
  }

  if (intent === "remove") {
    writeCart(
      Astro.cookies,
      slug,
      removeCartItem(cart, String(form.get("productId") ?? ""))
    )
    return Astro.redirect(`/${slug}/cart`, 303)
  }

  if (intent === "clear") {
    clearCart(Astro.cookies, slug)
    return Astro.redirect(`/${slug}/cart`, 303)
  }

  if (intent === "checkout") {
    formValues = {
      buyerName: String(form.get("buyerName") ?? ""),
      buyerPhone: String(form.get("buyerPhone") ?? ""),
      fulfillment: canDeliver
        ? String(form.get("fulfillment") ?? "pickup")
        : "pickup",
      paymentMethod: String(form.get("paymentMethod") ?? "cash_on_delivery"),
      buyerLocation: String(form.get("buyerLocation") ?? ""),
    }

    const parsed = checkoutSchema.safeParse(formValues)
    if (!parsed.success) {
      formError = "Revisa los datos del pedido"
      fieldErrors = fieldErrorsFromZod(parsed.error)
    } else {
      const checkoutItems = lines.map((line) => ({
        productId: line.productId,
        quantity: line.quantity,
      }))
      writeCart(Astro.cookies, slug, checkoutItems)
      const result = await createOrder(slug, checkoutItems, parsed.data)
      if (result.ok) {
        clearCart(Astro.cookies, slug)
        return Astro.redirect(`/${slug}/order/${result.order.id}`, 303)
      }
      formError = result.error
      fieldErrors = result.fieldErrors
      if (result.status === 404) {
        return Astro.redirect(`/${slug}/cart`, 303)
      }
    }
  }
}
const focusRing =
  "focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-4 focus-visible:ring-offset-background focus-visible:outline-none"
const focusRingSage = focusRing.replace("offset-background", "offset-sage")
const primaryButton =
  "inline-flex items-center justify-center rounded-full bg-primary px-8 py-4 text-base font-medium text-primary-foreground transition-colors hover:bg-primary/90"
const outlineButton =
  "rounded-full border border-primary/25 px-4 py-2 text-sm text-primary transition-colors hover:border-primary"
const linkButton =
  "rounded-full px-2 py-2 text-sm text-foreground/75 underline decoration-brass decoration-2 underline-offset-[6px] transition-colors hover:text-foreground"
---

<Layout title={`Pedido | ${store.business.name}`}>
  <div class="storefront min-h-svh bg-background text-foreground">
    <header
      class="sticky top-0 z-40 border-b border-border bg-background/90 backdrop-blur-md"
    >
      <div
        class="mx-auto flex w-full max-w-7xl items-center justify-between gap-4 px-5 py-4 md:px-10 md:py-5"
      >
        <div class="flex min-w-0 items-center gap-4 md:gap-6">
          <a
            href={`/${slug}`}
            class:list={[
              "font-display min-w-0 truncate text-2xl leading-none font-semibold tracking-[-0.02em] text-primary md:text-[2rem]",
              focusRing,
            ]}
          >
            {store.business.name}
          </a>
          <a
            href={webUrl}
            class:list={[
              "shrink-0 text-sm text-muted-foreground transition-colors hover:text-foreground",
              focusRing,
            ]}
          >
            Entregado
          </a>
        </div>
        <a
          href={`/${slug}`}
          class:list={[
            "shrink-0 rounded-full border border-primary/25 px-4 py-2 text-sm text-primary transition-colors hover:border-primary",
            focusRing,
          ]}
        >
          Seguir comprando
        </a>
      </div>
    </header>

    <main
      class="mx-auto flex w-full max-w-7xl flex-col gap-10 px-5 pt-12 pb-24 md:px-10 md:pt-16"
    >
      <div class="flex flex-col gap-4">
        <h1
          class="font-display text-[2.6rem] leading-[1.02] font-semibold tracking-[-0.025em] text-primary md:text-6xl"
        >
          Tu pedido
        </h1>
        <p class="text-base text-foreground/75">
          {unitCount}{" "}
          {unitCount === 1 ? "artículo" : "artículos"} ·{" "}
          <span class="lining-nums">{formatCordoba(total)}</span>
        </p>
      </div>

      {
        droppedProducts ? (
          <p
            class="bg-butter max-w-xl rounded-2xl px-4 py-3 text-sm text-primary"
            role="status"
          >
            Quitamos los productos que el negocio ya no tiene disponibles.
          </p>
        ) : null
      }

      {
        formError ? (
          <p
            class="max-w-xl rounded-2xl bg-destructive/10 px-4 py-3 text-sm text-destructive"
            role="alert"
          >
            {formError}
          </p>
        ) : null
      }

      {
        fieldErrors.quantity ? (
          <p
            class="max-w-xl rounded-2xl bg-destructive/10 px-4 py-3 text-sm text-destructive"
            role="alert"
          >
            {fieldErrors.quantity}
          </p>
        ) : null
      }

      {
        lines.length === 0 ? (
          <section class="bg-sage flex max-w-xl flex-col items-start gap-5 rounded-[2rem] p-8">
            <p class="text-base text-foreground/75">
              Todavía no agregaste productos.
            </p>
            <a href={`/${slug}`} class:list={[primaryButton, focusRing]}>
              Ver productos
            </a>
          </section>
        ) : (
          <div class="grid items-start gap-10 lg:grid-cols-[1.2fr_1fr] lg:gap-14">
            <section
              class="flex flex-col gap-5"
              aria-labelledby="items-heading"
            >
              <h2
                id="items-heading"
                class="font-display text-3xl font-semibold tracking-[-0.02em] text-primary"
              >
                Productos
              </h2>
              <ul class="flex flex-col gap-4">
                {lines.map((line) => (
                  <li class="bg-sage flex flex-col gap-4 rounded-[2rem] p-5 sm:flex-row sm:items-center sm:justify-between">
                    <div class="flex flex-col gap-1">
                      <p class="font-display text-xl leading-tight font-bold text-primary">
                        {line.name}
                      </p>
                      <p class="text-sm text-foreground/75 lining-nums">
                        {formatCordoba(line.unitPrice)} c/u
                      </p>
                      <p class="font-display text-lg font-semibold text-primary lining-nums">
                        {formatCordoba(line.lineTotal)}
                      </p>
                    </div>
                    <div class="flex flex-wrap items-center gap-3">
                      <form method="post" class="flex items-center gap-2">
                        <input
                          type="hidden"
                          name="productId"
                          value={line.productId}
                        />
                        <Input
                          className="w-20 rounded-full bg-background"
                          aria-label={`Cantidad de ${line.name}`}
                          name="quantity"
                          type="number"
                          min="1"
                          max="99"
                          required
                          defaultValue={String(line.quantity)}
                        />
                        <button
                          class:list={[outlineButton, focusRingSage]}
                          type="submit"
                          name="intent"
                          value="update"
                        >
                          Actualizar
                        </button>
                      </form>
                      <form method="post">
                        <input
                          type="hidden"
                          name="productId"
                          value={line.productId}
                        />
                        <button
                          class:list={[linkButton, focusRingSage]}
                          type="submit"
                          name="intent"
                          value="remove"
                        >
                          Quitar
                        </button>
                      </form>
                    </div>
                  </li>
                ))}
              </ul>
              <form method="post">
                <button
                  class:list={[linkButton, focusRing]}
                  type="submit"
                  name="intent"
                  value="clear"
                >
                  Vaciar pedido
                </button>
              </form>
            </section>

            <form
              method="post"
              class="bg-sage flex flex-col gap-6 rounded-[2rem] p-6 md:p-8 lg:sticky lg:top-28 [&_input]:bg-background [&_select]:bg-background [&_textarea]:bg-background"
              id="checkout-form"
            >
              <h2 class="font-display text-3xl font-semibold tracking-[-0.02em] text-primary">
                Tus datos
              </h2>
              <FieldGroup>
                <Field data-invalid={fieldErrors.buyerName ? true : undefined}>
                  <FieldLabel htmlFor="buyerName">Tu nombre</FieldLabel>
                  <Input
                    id="buyerName"
                    name="buyerName"
                    autoComplete="name"
                    defaultValue={formValues.buyerName}
                    required
                    aria-invalid={fieldErrors.buyerName ? true : undefined}
                    aria-describedby={
                      fieldErrors.buyerName ? "buyer-name-error" : undefined
                    }
                  />
                  {fieldErrors.buyerName ? (
                    <FieldError id="buyer-name-error">
                      {fieldErrors.buyerName}
                    </FieldError>
                  ) : null}
                </Field>
                <Field data-invalid={fieldErrors.buyerPhone ? true : undefined}>
                  <FieldLabel htmlFor="buyerPhone">Teléfono</FieldLabel>
                  <Input
                    id="buyerPhone"
                    name="buyerPhone"
                    type="tel"
                    inputMode="numeric"
                    autoComplete="tel"
                    defaultValue={formValues.buyerPhone}
                    required
                    aria-invalid={fieldErrors.buyerPhone ? true : undefined}
                    aria-describedby={
                      fieldErrors.buyerPhone ? "buyer-phone-error" : undefined
                    }
                  />
                  <FieldDescription>8 dígitos de Nicaragua.</FieldDescription>
                  {fieldErrors.buyerPhone ? (
                    <FieldError id="buyer-phone-error">
                      {fieldErrors.buyerPhone}
                    </FieldError>
                  ) : null}
                </Field>
                {canDeliver ? (
                  <Field
                    data-invalid={fieldErrors.fulfillment ? true : undefined}
                  >
                    <FieldLabel htmlFor="fulfillment">Entrega</FieldLabel>
                    <NativeSelect
                      id="fulfillment"
                      name="fulfillment"
                      className="w-full"
                      defaultValue={formValues.fulfillment}
                      required
                      aria-invalid={fieldErrors.fulfillment ? true : undefined}
                      aria-describedby={
                        fieldErrors.fulfillment
                          ? "fulfillment-error"
                          : undefined
                      }
                    >
                      <NativeSelectOption value="delivery">
                        Delivery
                      </NativeSelectOption>
                      <NativeSelectOption value="pickup">
                        Retiro en el negocio
                      </NativeSelectOption>
                    </NativeSelect>
                    {fieldErrors.fulfillment ? (
                      <FieldError id="fulfillment-error">
                        {fieldErrors.fulfillment}
                      </FieldError>
                    ) : null}
                  </Field>
                ) : (
                  <p class="text-sm text-muted-foreground">
                    Estos productos se retiran en el negocio.
                  </p>
                )}
                {canDeliver ? (
                  <Field
                    id="location-field"
                    hidden={
                      formValues.fulfillment !== "delivery" ? true : undefined
                    }
                    data-invalid={fieldErrors.buyerLocation ? true : undefined}
                  >
                    <FieldLabel htmlFor="buyerLocation">Ubicación</FieldLabel>
                    <Textarea
                      id="buyerLocation"
                      name="buyerLocation"
                      defaultValue={formValues.buyerLocation}
                      required={formValues.fulfillment === "delivery"}
                      aria-invalid={
                        fieldErrors.buyerLocation ? true : undefined
                      }
                      aria-describedby={
                        fieldErrors.buyerLocation
                          ? "buyer-location-error"
                          : undefined
                      }
                    />
                    <FieldDescription>
                      Dirección o referencia para el repartidor.
                    </FieldDescription>
                    {fieldErrors.buyerLocation ? (
                      <FieldError id="buyer-location-error">
                        {fieldErrors.buyerLocation}
                      </FieldError>
                    ) : null}
                  </Field>
                ) : null}
                <Field
                  data-invalid={fieldErrors.paymentMethod ? true : undefined}
                >
                  <FieldLabel htmlFor="paymentMethod">
                    ¿Cómo vas a pagar?
                  </FieldLabel>
                  <NativeSelect
                    id="paymentMethod"
                    name="paymentMethod"
                    className="w-full"
                    defaultValue={formValues.paymentMethod}
                    required
                    aria-invalid={fieldErrors.paymentMethod ? true : undefined}
                    aria-describedby={
                      fieldErrors.paymentMethod
                        ? "payment-method-error"
                        : undefined
                    }
                  >
                    <NativeSelectOption value="cash_on_delivery">
                      Efectivo al entregar
                    </NativeSelectOption>
                    <NativeSelectOption value="transfer">
                      Transferencia
                    </NativeSelectOption>
                  </NativeSelect>
                  <FieldDescription
                    id="transfer-note"
                    hidden={formValues.paymentMethod !== "transfer"}
                  >
                    Si pagas por transferencia, el negocio coordina el pago
                    contigo.
                  </FieldDescription>
                  {fieldErrors.paymentMethod ? (
                    <FieldError id="payment-method-error">
                      {fieldErrors.paymentMethod}
                    </FieldError>
                  ) : null}
                </Field>
              </FieldGroup>
              <button
                class:list={[primaryButton, focusRingSage, "w-full"]}
                type="submit"
                name="intent"
                value="checkout"
              >
                Hacer pedido · {formatCordoba(total)}
              </button>
            </form>
          </div>
        )
      }
    </main>
  </div>
</Layout>

<script>
  const select = document.getElementById("fulfillment")
  const field = document.getElementById("location-field")
  const input = document.getElementById("buyerLocation")
  if (
    select instanceof HTMLSelectElement &&
    field instanceof HTMLElement &&
    input instanceof HTMLTextAreaElement
  ) {
    const syncLocation = () => {
      const isDelivery = select.value === "delivery"
      field.hidden = !isDelivery
      input.required = isDelivery
    }
    select.addEventListener("change", syncLocation)
    syncLocation()
  }

  const paymentSelect = document.getElementById("paymentMethod")
  const transferNote = document.getElementById("transfer-note")
  if (
    paymentSelect instanceof HTMLSelectElement &&
    transferNote instanceof HTMLElement
  ) {
    const syncTransferNote = () => {
      transferNote.hidden = paymentSelect.value !== "transfer"
    }
    paymentSelect.addEventListener("change", syncTransferNote)
    syncTransferNote()
  }
</script>
