---
import { buttonVariants } from "@workspace/ui/components/button"
import {
  Field,
  FieldDescription,
  FieldError,
  FieldGroup,
  FieldLabel,
} from "@workspace/ui/components/field"
import { Input } from "@workspace/ui/components/input"
import {
  NativeSelect,
  NativeSelectOption,
} from "@workspace/ui/components/native-select"
import { Textarea } from "@workspace/ui/components/textarea"
import { formatCordoba } from "@entregado/utils"
import Layout from "../../layouts/main.astro"
import { fieldErrorsFromZod, getStorefront } from "../../lib/businesses"
import {
  cartItemSchema,
  clearCart,
  readCart,
  removeCartItem,
  setCartItemQuantity,
  toCartLines,
  writeCart,
} from "../../lib/cart"
import {
  checkoutSchema,
  createOrder,
  type CheckoutFieldErrors,
} from "../../lib/orders"

export const prerender = false

const slug = Astro.params.slug

if (!slug) {
  return Astro.rewrite("/404")
}

const store = await getStorefront(slug)
if (!store) {
  return Astro.rewrite("/404")
}

const cart = readCart(Astro.cookies, slug)

const lines = toCartLines(cart, store.products)
const droppedProducts = lines.length !== cart.length

// Keep the cookie in sync with the catalog so a hidden or deleted product
// never blocks checkout.
if (droppedProducts) {
  writeCart(
    Astro.cookies,
    slug,
    lines.map((line) => ({
      productId: line.productId,
      quantity: line.quantity,
    }))
  )
}

const unitCount = lines.reduce((sum, line) => sum + line.quantity, 0)
const total = lines.reduce((sum, line) => sum + line.lineTotal, 0)
const canDeliver =
  lines.length > 0 && lines.every((line) => line.supportsDelivery)

let formValues = {
  buyerName: "",
  buyerPhone: "",
  fulfillment: canDeliver ? "delivery" : "pickup",
  paymentMethod: "cash_on_delivery",
  buyerLocation: "",
}
let fieldErrors: CheckoutFieldErrors = {}
let formError = ""

if (Astro.request.method === "POST") {
  const form = await Astro.request.formData()
  const intent = String(form.get("intent") ?? "")

  if (intent === "update") {
    const parsed = cartItemSchema.safeParse({
      productId: form.get("productId"),
      quantity: form.get("quantity"),
    })
    if (parsed.success) {
      writeCart(
        Astro.cookies,
        slug,
        setCartItemQuantity(cart, parsed.data.productId, parsed.data.quantity)
      )
    }
    return Astro.redirect(`/${slug}/cart`, 303)
  }

  if (intent === "remove") {
    writeCart(
      Astro.cookies,
      slug,
      removeCartItem(cart, String(form.get("productId") ?? ""))
    )
    return Astro.redirect(`/${slug}/cart`, 303)
  }

  if (intent === "clear") {
    clearCart(Astro.cookies, slug)
    return Astro.redirect(`/${slug}/cart`, 303)
  }

  if (intent === "checkout") {
    formValues = {
      buyerName: String(form.get("buyerName") ?? ""),
      buyerPhone: String(form.get("buyerPhone") ?? ""),
      fulfillment: canDeliver
        ? String(form.get("fulfillment") ?? "pickup")
        : "pickup",
      paymentMethod: String(form.get("paymentMethod") ?? "cash_on_delivery"),
      buyerLocation: String(form.get("buyerLocation") ?? ""),
    }

    const parsed = checkoutSchema.safeParse(formValues)
    if (!parsed.success) {
      formError = "Revisa los datos del pedido"
      fieldErrors = fieldErrorsFromZod(parsed.error)
    } else {
      const checkoutItems = lines.map((line) => ({
        productId: line.productId,
        quantity: line.quantity,
      }))
      writeCart(Astro.cookies, slug, checkoutItems)
      const result = await createOrder(slug, checkoutItems, parsed.data)
      if (result.ok) {
        clearCart(Astro.cookies, slug)
        return Astro.redirect(`/${slug}/order/${result.order.id}`, 303)
      }
      formError = result.error
      fieldErrors = result.fieldErrors
      if (result.status === 404) {
        return Astro.redirect(`/${slug}/cart`, 303)
      }
    }
  }
}
---

<Layout title={`Pedido | ${store.business.name}`}>
  <main class="mx-auto flex min-h-svh w-full max-w-lg flex-col gap-8 p-6">
    <header class="flex flex-col gap-2">
      <a
        href={`/${slug}`}
        class="text-sm text-muted-foreground underline-offset-4 hover:underline"
      >
        {store.business.name}
      </a>
      <h1 class="text-xl font-medium">Tu pedido</h1>
      <p class="text-sm text-muted-foreground">
        {unitCount}
        {unitCount === 1 ? "artículo" : "artículos"} ·{" "}
        {formatCordoba(total)}
      </p>
    </header>

    {
      droppedProducts ? (
        <p class="text-sm text-muted-foreground" role="status">
          Quitamos los productos que el negocio ya no tiene disponibles.
        </p>
      ) : null
    }

    {
      formError ? (
        <p class="text-sm text-destructive" role="alert">
          {formError}
        </p>
      ) : null
    }

    {
      fieldErrors.quantity ? (
        <p class="text-sm text-destructive" role="alert">
          {fieldErrors.quantity}
        </p>
      ) : null
    }

    {
      lines.length === 0 ? (
        <section class="flex flex-col gap-4">
          <p class="text-sm text-muted-foreground">
            Todavía no agregaste productos.
          </p>
          <a
            href={`/${slug}`}
            class="text-sm font-medium underline-offset-4 hover:underline"
          >
            Ver productos
          </a>
        </section>
      ) : (
        <section class="flex flex-col gap-5" aria-labelledby="items-heading">
          <h2 id="items-heading" class="text-sm font-medium">
            Productos
          </h2>
          <ul class="flex flex-col gap-5">
            {lines.map((line) => (
              <li class="flex flex-col gap-2 border-b border-border pb-4">
                <p class="text-sm font-medium">{line.name}</p>
                <p class="text-sm text-muted-foreground">
                  {formatCordoba(line.unitPrice)} c/u ·{" "}
                  {formatCordoba(line.lineTotal)}
                </p>
                <form method="post" class="flex items-end gap-2">
                  <input
                    type="hidden"
                    name="productId"
                    value={line.productId}
                  />
                  <Input
                    className="w-20"
                    aria-label={`Cantidad de ${line.name}`}
                    name="quantity"
                    type="number"
                    min="1"
                    max="99"
                    defaultValue={String(line.quantity)}
                  />
                  <button
                    class={buttonVariants({ variant: "outline", size: "sm" })}
                    type="submit"
                    name="intent"
                    value="update"
                  >
                    Actualizar
                  </button>
                </form>
                <form method="post">
                  <input
                    type="hidden"
                    name="productId"
                    value={line.productId}
                  />
                  <button
                    class={buttonVariants({ variant: "ghost", size: "sm" })}
                    type="submit"
                    name="intent"
                    value="remove"
                  >
                    Quitar
                  </button>
                </form>
              </li>
            ))}
          </ul>
          <form method="post">
            <button
              class={buttonVariants({ variant: "ghost", size: "sm" })}
              type="submit"
              name="intent"
              value="clear"
            >
              Vaciar pedido
            </button>
          </form>
        </section>
      )
    }

    {
      lines.length > 0 ? (
        <form method="post" class="flex flex-col gap-5" id="checkout-form">
          <FieldGroup>
            <Field data-invalid={fieldErrors.buyerName ? true : undefined}>
              <FieldLabel htmlFor="buyerName">Tu nombre</FieldLabel>
              <Input
                id="buyerName"
                name="buyerName"
                autoComplete="name"
                defaultValue={formValues.buyerName}
                required
                aria-invalid={fieldErrors.buyerName ? true : undefined}
                aria-describedby={
                  fieldErrors.buyerName ? "buyer-name-error" : undefined
                }
              />
              {fieldErrors.buyerName ? (
                <FieldError id="buyer-name-error">
                  {fieldErrors.buyerName}
                </FieldError>
              ) : null}
            </Field>
            <Field data-invalid={fieldErrors.buyerPhone ? true : undefined}>
              <FieldLabel htmlFor="buyerPhone">Teléfono</FieldLabel>
              <Input
                id="buyerPhone"
                name="buyerPhone"
                type="tel"
                inputMode="numeric"
                autoComplete="tel"
                defaultValue={formValues.buyerPhone}
                required
                aria-invalid={fieldErrors.buyerPhone ? true : undefined}
                aria-describedby={
                  fieldErrors.buyerPhone ? "buyer-phone-error" : undefined
                }
              />
              <FieldDescription>8 dígitos de Nicaragua.</FieldDescription>
              {fieldErrors.buyerPhone ? (
                <FieldError id="buyer-phone-error">
                  {fieldErrors.buyerPhone}
                </FieldError>
              ) : null}
            </Field>
            {canDeliver ? (
              <Field data-invalid={fieldErrors.fulfillment ? true : undefined}>
                <FieldLabel htmlFor="fulfillment">Entrega</FieldLabel>
                <NativeSelect
                  id="fulfillment"
                  name="fulfillment"
                  className="w-full"
                  defaultValue={formValues.fulfillment}
                  required
                  aria-invalid={fieldErrors.fulfillment ? true : undefined}
                  aria-describedby={
                    fieldErrors.fulfillment ? "fulfillment-error" : undefined
                  }
                >
                  <NativeSelectOption value="delivery">
                    Delivery
                  </NativeSelectOption>
                  <NativeSelectOption value="pickup">
                    Retiro en el negocio
                  </NativeSelectOption>
                </NativeSelect>
                {fieldErrors.fulfillment ? (
                  <FieldError id="fulfillment-error">
                    {fieldErrors.fulfillment}
                  </FieldError>
                ) : null}
              </Field>
            ) : (
              <p class="text-sm text-muted-foreground">
                Estos productos se retiran en el negocio.
              </p>
            )}
            {canDeliver ? (
              <Field
                id="location-field"
                hidden={
                  formValues.fulfillment !== "delivery" ? true : undefined
                }
                data-invalid={fieldErrors.buyerLocation ? true : undefined}
              >
                <FieldLabel htmlFor="buyerLocation">Ubicación</FieldLabel>
                <Textarea
                  id="buyerLocation"
                  name="buyerLocation"
                  defaultValue={formValues.buyerLocation}
                  required={formValues.fulfillment === "delivery"}
                  aria-invalid={fieldErrors.buyerLocation ? true : undefined}
                  aria-describedby={
                    fieldErrors.buyerLocation
                      ? "buyer-location-error"
                      : undefined
                  }
                />
                <FieldDescription>
                  Dirección o referencia para el repartidor.
                </FieldDescription>
                {fieldErrors.buyerLocation ? (
                  <FieldError id="buyer-location-error">
                    {fieldErrors.buyerLocation}
                  </FieldError>
                ) : null}
              </Field>
            ) : null}
            <Field data-invalid={fieldErrors.paymentMethod ? true : undefined}>
              <FieldLabel htmlFor="paymentMethod">
                ¿Cómo vas a pagar?
              </FieldLabel>
              <NativeSelect
                id="paymentMethod"
                name="paymentMethod"
                className="w-full"
                defaultValue={formValues.paymentMethod}
                required
                aria-invalid={fieldErrors.paymentMethod ? true : undefined}
                aria-describedby={
                  fieldErrors.paymentMethod ? "payment-method-error" : undefined
                }
              >
                <NativeSelectOption value="cash_on_delivery">
                  Efectivo al entregar
                </NativeSelectOption>
                <NativeSelectOption value="transfer">
                  Transferencia
                </NativeSelectOption>
              </NativeSelect>
              <FieldDescription
                id="transfer-note"
                hidden={formValues.paymentMethod !== "transfer"}
              >
                Si pagas por transferencia, el negocio coordina el pago contigo.
              </FieldDescription>
              {fieldErrors.paymentMethod ? (
                <FieldError id="payment-method-error">
                  {fieldErrors.paymentMethod}
                </FieldError>
              ) : null}
            </Field>
          </FieldGroup>
          <button
            class={buttonVariants()}
            type="submit"
            name="intent"
            value="checkout"
          >
            Hacer pedido · {formatCordoba(total)}
          </button>
        </form>
      ) : null
    }
  </main>
</Layout>

<script>
  const select = document.getElementById("fulfillment")
  const field = document.getElementById("location-field")
  const input = document.getElementById("buyerLocation")
  if (
    select instanceof HTMLSelectElement &&
    field instanceof HTMLElement &&
    input instanceof HTMLTextAreaElement
  ) {
    const syncLocation = () => {
      const isDelivery = select.value === "delivery"
      field.hidden = !isDelivery
      input.required = isDelivery
    }
    select.addEventListener("change", syncLocation)
    syncLocation()
  }

  const paymentSelect = document.getElementById("paymentMethod")
  const transferNote = document.getElementById("transfer-note")
  if (
    paymentSelect instanceof HTMLSelectElement &&
    transferNote instanceof HTMLElement
  ) {
    const syncTransferNote = () => {
      transferNote.hidden = paymentSelect.value !== "transfer"
    }
    paymentSelect.addEventListener("change", syncTransferNote)
    syncTransferNote()
  }
</script>
