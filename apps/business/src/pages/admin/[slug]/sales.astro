---
import type { Id } from "@entregado/backend"
import type { OrderView } from "@entregado/types"
import { buttonVariants } from "@workspace/ui/components/button"
import { formatCordoba, nicaraguaLocalDigits } from "@entregado/utils"
import AdminNav from "../../../components/admin-nav.astro"
import PaginationNav from "../../../components/pagination-nav.astro"
import Layout from "../../../layouts/main.astro"
import { getManagedBusiness } from "../../../lib/businesses"
import {
  cancelOrderAsOwner,
  completeOrderAsOwner,
  fulfillmentLabel,
  listManagedOrders,
  orderItemLines,
  orderStatusLabel,
  orderUnitCountLabel,
  paymentMethodLabel,
  paymentStatusLabel,
  setOrderPaidAsOwner,
  type OrderActionResult,
} from "../../../lib/orders"
import { buyerNoticeUrl } from "../../../lib/whatsapp"

const slug = Astro.params.slug
const token = Astro.locals.convexToken
const cursor = Astro.url.searchParams.get("cursor")

if (!slug || !token) {
  return new Response(null, { status: 404 })
}

const business = await getManagedBusiness(slug, token)
if (!business) {
  return new Response(null, { status: 404 })
}

let actionError = ""

if (Astro.request.method === "POST") {
  const form = await Astro.request.formData()
  const orderId = String(form.get("orderId") ?? "") as Id<"orders">
  const intent = String(form.get("intent") ?? "")
  let result: OrderActionResult

  if (intent === "complete") {
    result = await completeOrderAsOwner(slug, orderId, token)
  } else if (intent === "cancel") {
    result = await cancelOrderAsOwner(slug, orderId, token)
  } else if (intent === "pay") {
    result = await setOrderPaidAsOwner(slug, orderId, true, token)
  } else if (intent === "unpay") {
    result = await setOrderPaidAsOwner(slug, orderId, false, token)
  } else {
    result = { ok: false, error: "Acción no válida" }
  }

  if (result.ok) {
    return Astro.redirect(`/admin/${slug}/sales`, 303)
  }
  actionError = result.error
}

const { open, recent } = await listManagedOrders(slug, token, cursor)

function orderSummary(order: OrderView) {
  return `${orderUnitCountLabel(order.itemCount)} · ${formatCordoba(order.totalPrice)}`
}
---

<Layout title={`Pedidos | ${business.name}`}>
  <main class="mx-auto flex min-h-svh w-full max-w-lg flex-col gap-8 p-6">
    <AdminNav slug={business.slug} name={business.name} current="sales" />

    {
      actionError ? (
        <p class="text-sm text-destructive" role="alert">
          {actionError}
        </p>
      ) : null
    }

    <section class="flex flex-col gap-4" aria-labelledby="open-orders-heading">
      <h2 id="open-orders-heading" class="text-sm font-medium">En curso</h2>
      {
        open.page.length === 0 ? (
          <p class="text-sm text-muted-foreground">No hay pedidos en curso.</p>
        ) : (
          <ul class="flex flex-col gap-6">
            {open.page.map((order) => (
              <li class="flex flex-col gap-2 border-b border-border pb-4">
                <p class="text-sm font-medium">{orderSummary(order)}</p>
                <ul class="flex flex-col gap-0.5 text-sm text-muted-foreground">
                  {orderItemLines(order).map((line) => (
                    <li>{line}</li>
                  ))}
                </ul>
                <p class="text-sm text-muted-foreground">
                  {orderStatusLabel(order.status)} ·{" "}
                  {fulfillmentLabel(order.fulfillment)}
                  {order.riderName ? ` · ${order.riderName}` : ""}
                </p>
                <p class="text-sm text-muted-foreground">
                  {order.buyerName} · {nicaraguaLocalDigits(order.buyerPhone)}
                </p>
                {order.buyerLocation ? (
                  <p class="text-sm text-muted-foreground">
                    {order.buyerLocation}
                  </p>
                ) : null}
                <p class="text-sm text-muted-foreground">
                  {paymentMethodLabel(order.paymentMethod)} ·{" "}
                  {paymentStatusLabel(order.paymentStatus)}
                </p>
                {order.paymentStatus === "pending" ? (
                  <p class="text-sm">
                    Por cobrar {formatCordoba(order.totalPrice)}
                  </p>
                ) : null}
                <div class="flex flex-wrap gap-3">
                  {order.fulfillment === "pickup" ? (
                    <form method="post">
                      <input type="hidden" name="orderId" value={order.id} />
                      <button
                        class={buttonVariants()}
                        type="submit"
                        name="intent"
                        value="complete"
                      >
                        Completar
                      </button>
                    </form>
                  ) : null}
                  <a
                    class={buttonVariants({ variant: "outline" })}
                    href={buyerNoticeUrl(order)}
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    Avisar al cliente
                  </a>
                  <form method="post">
                    <input type="hidden" name="orderId" value={order.id} />
                    <button
                      class={buttonVariants({ variant: "outline" })}
                      type="submit"
                      name="intent"
                      value={order.paymentStatus === "paid" ? "unpay" : "pay"}
                    >
                      {order.paymentStatus === "paid"
                        ? "Marcar sin pagar"
                        : "Marcar pagado"}
                    </button>
                  </form>
                  <form method="post">
                    <input type="hidden" name="orderId" value={order.id} />
                    <button
                      class={buttonVariants({ variant: "ghost" })}
                      type="submit"
                      name="intent"
                      value="cancel"
                    >
                      Cancelar
                    </button>
                  </form>
                </div>
              </li>
            ))}
          </ul>
        )
      }

      <PaginationNav
        basePath={`/admin/${slug}/sales`}
        cursor={cursor}
        isDone={open.isDone}
        continueCursor={open.continueCursor}
      />
    </section>

    <section
      class="flex flex-col gap-4"
      aria-labelledby="recent-orders-heading"
    >
      <h2 id="recent-orders-heading" class="text-sm font-medium">Recientes</h2>
      {
        recent.length === 0 ? (
          <p class="text-sm text-muted-foreground">
            Todavía no hay pedidos cerrados.
          </p>
        ) : (
          <ul class="flex flex-col gap-3">
            {recent.map((order) => (
              <li class="flex flex-col gap-2 border-b border-border pb-3">
                <p class="text-sm font-medium">{orderSummary(order)}</p>
                <p class="text-sm text-muted-foreground">
                  {orderItemLines(order).join(", ")}
                </p>
                <p class="text-sm text-muted-foreground">
                  {orderStatusLabel(order.status)} ·{" "}
                  {fulfillmentLabel(order.fulfillment)}
                  {" · "}
                  {order.buyerName}
                </p>
                <p class="text-sm text-muted-foreground">
                  {paymentMethodLabel(order.paymentMethod)} ·{" "}
                  {paymentStatusLabel(order.paymentStatus)}
                </p>
                {order.paymentStatus === "pending" ? (
                  <p class="text-sm">
                    Por cobrar {formatCordoba(order.totalPrice)}
                  </p>
                ) : null}
                <form method="post">
                  <input type="hidden" name="orderId" value={order.id} />
                  <button
                    class={buttonVariants({ variant: "outline" })}
                    type="submit"
                    name="intent"
                    value={order.paymentStatus === "paid" ? "unpay" : "pay"}
                  >
                    {order.paymentStatus === "paid"
                      ? "Marcar sin pagar"
                      : "Marcar pagado"}
                  </button>
                </form>
              </li>
            ))}
          </ul>
        )
      }
    </section>
  </main>
</Layout>
