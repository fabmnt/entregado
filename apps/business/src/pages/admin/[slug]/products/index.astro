---
import { buttonVariants } from "@workspace/ui/components/button"
import {
  Field,
  FieldDescription,
  FieldError,
  FieldGroup,
  FieldLabel,
} from "@workspace/ui/components/field"
import { Input } from "@workspace/ui/components/input"
import { Textarea } from "@workspace/ui/components/textarea"
import { formatCordoba } from "@entregado/utils"
import AdminNav from "../../../../components/admin-nav.astro"
import Layout from "../../../../layouts/main.astro"
import {
  fieldErrorsFromZod,
  getManagedBusiness,
} from "../../../../lib/businesses"
import {
  deleteUploadedImage,
  imageFieldError,
  isFilledFile,
  uploadImage,
} from "../../../../lib/images"
import {
  createProduct,
  listManagedProducts,
  productFormSchema,
  type ProductFieldErrors,
} from "../../../../lib/products"

const slug = Astro.params.slug
const token = Astro.locals.convexToken

if (!slug || !token) {
  return new Response(null, { status: 404 })
}

const business = await getManagedBusiness(slug, token)
if (!business) {
  return new Response(null, { status: 404 })
}

let formValues = {
  name: "",
  description: "",
  price: "",
  available: true,
}
let fieldErrors: ProductFieldErrors = {}
let formError = ""

if (Astro.request.method === "POST") {
  const form = await Astro.request.formData()
  formValues = {
    name: String(form.get("name") ?? ""),
    description: String(form.get("description") ?? ""),
    price: String(form.get("price") ?? ""),
    available: form.get("available") === "on",
  }

  const photo = form.get("photo")
  let photoStorageId: Awaited<ReturnType<typeof uploadImage>> | undefined
  let skipCreate = false

  const parsed = productFormSchema.safeParse(formValues)
  if (!parsed.success) {
    formError = "Revisa los datos del producto"
    fieldErrors = fieldErrorsFromZod<keyof ProductFieldErrors & string>(
      parsed.error
    )
    skipCreate = true
  } else if (isFilledFile(photo)) {
    const imageError = imageFieldError(photo)
    if (imageError) {
      formError = imageError
      fieldErrors = { photo: imageError }
      skipCreate = true
    } else {
      photoStorageId = await uploadImage(photo, token)
    }
  }

  if (parsed.success && !skipCreate) {
    let mutationSucceeded = false
    try {
      const result = await createProduct(
        slug,
        parsed.data,
        token,
        photoStorageId
      )
      if (result.ok) {
        mutationSucceeded = true
        return Astro.redirect(`/admin/${slug}/products`, 303)
      }

      formError = result.error
      fieldErrors = result.fieldErrors
    } catch {
      formError = "No se pudo crear el producto"
    } finally {
      if (!mutationSucceeded && photoStorageId) {
        const cleanedUp = await deleteUploadedImage(photoStorageId, token)
        if (!cleanedUp) {
          formError = `${formError}. No se pudo limpiar la imagen temporal.`
        }
      }
    }
  }
}

const products = await listManagedProducts(slug, token)
---

<Layout title={`Productos | ${business.name}`}>
  <main class="mx-auto flex min-h-svh w-full max-w-lg flex-col gap-8 p-6">
    <AdminNav slug={business.slug} name={business.name} current="products" />

    {
      products.length === 0 ? (
        <p class="text-sm text-muted-foreground">Todavía no hay productos.</p>
      ) : (
        <ul class="flex flex-col gap-3">
          {products.map((product) => (
            <li class="flex items-start justify-between gap-4 border-b border-border pb-3">
              <div class="flex flex-col gap-0.5">
                <span class="text-sm font-medium">{product.name}</span>
                <span class="text-sm text-muted-foreground">
                  {formatCordoba(product.price)}
                  {product.available ? "" : " · Oculto"}
                </span>
              </div>
              <a
                href={`/admin/${slug}/products/${product.id}`}
                class="text-sm text-muted-foreground underline-offset-4 hover:underline"
              >
                Editar
              </a>
            </li>
          ))}
        </ul>
      )
    }

    <form
      method="post"
      enctype="multipart/form-data"
      class="flex flex-col gap-5"
    >
      <h2 class="text-sm font-medium">Nuevo producto</h2>
      {
        formError ? (
          <p class="text-sm text-destructive" role="alert">
            {formError}
          </p>
        ) : null
      }
      <FieldGroup>
        <Field data-invalid={fieldErrors.name ? true : undefined}>
          <FieldLabel htmlFor="name">Nombre</FieldLabel>
          <Input
            id="name"
            name="name"
            defaultValue={formValues.name}
            required
            aria-invalid={fieldErrors.name ? true : undefined}
            aria-describedby={fieldErrors.name ? "name-error" : undefined}
          />
          {
            fieldErrors.name ? (
              <FieldError id="name-error">{fieldErrors.name}</FieldError>
            ) : null
          }
        </Field>
        <Field data-invalid={fieldErrors.description ? true : undefined}>
          <FieldLabel htmlFor="description">Descripción</FieldLabel>
          <Textarea
            id="description"
            name="description"
            defaultValue={formValues.description}
            required
            aria-invalid={fieldErrors.description ? true : undefined}
            aria-describedby={fieldErrors.description
              ? "description-error"
              : undefined}
          />
          {
            fieldErrors.description ? (
              <FieldError id="description-error">
                {fieldErrors.description}
              </FieldError>
            ) : null
          }
        </Field>
        <Field data-invalid={fieldErrors.price ? true : undefined}>
          <FieldLabel htmlFor="price">Precio (C$)</FieldLabel>
          <Input
            id="price"
            name="price"
            inputMode="decimal"
            defaultValue={formValues.price}
            required
            aria-invalid={fieldErrors.price ? true : undefined}
            aria-describedby={fieldErrors.price ? "price-error" : undefined}
          />
          {
            fieldErrors.price ? (
              <FieldError id="price-error">{fieldErrors.price}</FieldError>
            ) : null
          }
        </Field>
        <Field data-invalid={fieldErrors.photo ? true : undefined}>
          <FieldLabel htmlFor="photo">Foto (opcional)</FieldLabel>
          <Input
            id="photo"
            name="photo"
            type="file"
            accept="image/jpeg,image/png,image/webp"
            aria-invalid={fieldErrors.photo ? true : undefined}
            aria-describedby={fieldErrors.photo ? "photo-error" : undefined}
          />
          <FieldDescription>JPG, PNG o WebP. Máximo 2 MB.</FieldDescription>
          {
            fieldErrors.photo ? (
              <FieldError id="photo-error">{fieldErrors.photo}</FieldError>
            ) : null
          }
        </Field>
        <label class="flex items-center gap-2 text-sm">
          <input
            type="checkbox"
            name="available"
            checked={formValues.available ? true : undefined}
          />
          Visible en la tienda
        </label>
      </FieldGroup>
      <button class={buttonVariants()} type="submit">Añadir</button>
    </form>
  </main>
</Layout>
