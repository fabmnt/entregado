---
import { buttonVariants } from "@workspace/ui/components/button"
import {
  Field,
  FieldDescription,
  FieldError,
  FieldGroup,
  FieldLabel,
} from "@workspace/ui/components/field"
import { Input } from "@workspace/ui/components/input"
import AdminNav from "../../../components/admin-nav.astro"
import Layout from "../../../layouts/main.astro"
import { fieldErrorsFromZod, getManagedBusiness } from "../../../lib/businesses"
import {
  createRider,
  createRiderSchema,
  listManagedRiders,
  type RiderFieldErrors,
} from "../../../lib/riders"

const slug = Astro.params.slug
const token = Astro.locals.convexToken

if (!slug || !token) {
  return new Response(null, { status: 404 })
}

const business = await getManagedBusiness(slug, token)
if (!business) {
  return new Response(null, { status: 404 })
}

let formValues = {
  name: "",
  email: "",
  password: "",
}
let fieldErrors: RiderFieldErrors = {}
let formError = ""

if (Astro.request.method === "POST") {
  const form = await Astro.request.formData()
  formValues = {
    name: String(form.get("name") ?? ""),
    email: String(form.get("email") ?? ""),
    password: String(form.get("password") ?? ""),
  }

  const parsed = createRiderSchema.safeParse(formValues)
  if (!parsed.success) {
    formError = "Revisa los datos del repartidor"
    fieldErrors = fieldErrorsFromZod(parsed.error)
  } else {
    const result = await createRider(slug, parsed.data, token)
    if (result.ok) {
      return Astro.redirect(`/admin/${slug}/riders`, 303)
    }
    formError = result.error
    fieldErrors = result.fieldErrors
  }
}

const riders = await listManagedRiders(slug, token)
---

<Layout title={`Repartidores | ${business.name}`}>
  <main class="mx-auto flex min-h-svh w-full max-w-lg flex-col gap-8 p-6">
    <AdminNav slug={business.slug} name={business.name} current="riders" />

    {
      riders.length === 0 ? (
        <p class="text-sm text-muted-foreground">
          Todavía no hay repartidores.
        </p>
      ) : (
        <ul class="flex flex-col gap-3">
          {riders.map((rider) => (
            <li class="flex flex-col gap-0.5 border-b border-border pb-3">
              <span class="text-sm font-medium">{rider.name}</span>
              <span class="text-sm text-muted-foreground">{rider.email}</span>
            </li>
          ))}
        </ul>
      )
    }

    <form method="post" class="flex flex-col gap-5">
      <h2 class="text-sm font-medium">Nuevo repartidor</h2>
      {
        formError ? (
          <p class="text-sm text-destructive" role="alert">
            {formError}
          </p>
        ) : null
      }
      <FieldGroup>
        <Field data-invalid={fieldErrors.name ? true : undefined}>
          <FieldLabel htmlFor="name">Nombre</FieldLabel>
          <Input
            id="name"
            name="name"
            autoComplete="name"
            defaultValue={formValues.name}
            required
            aria-invalid={fieldErrors.name ? true : undefined}
            aria-describedby={fieldErrors.name ? "name-error" : undefined}
          />
          {
            fieldErrors.name ? (
              <FieldError id="name-error">{fieldErrors.name}</FieldError>
            ) : null
          }
        </Field>
        <Field data-invalid={fieldErrors.email ? true : undefined}>
          <FieldLabel htmlFor="email">Correo</FieldLabel>
          <Input
            id="email"
            name="email"
            type="email"
            autoComplete="email"
            defaultValue={formValues.email}
            required
            aria-invalid={fieldErrors.email ? true : undefined}
            aria-describedby={fieldErrors.email ? "email-error" : undefined}
          />
          {
            fieldErrors.email ? (
              <FieldError id="email-error">{fieldErrors.email}</FieldError>
            ) : null
          }
        </Field>
        <Field data-invalid={fieldErrors.password ? true : undefined}>
          <FieldLabel htmlFor="password">Contraseña</FieldLabel>
          <Input
            id="password"
            name="password"
            type="password"
            autoComplete="new-password"
            required
            aria-invalid={fieldErrors.password ? true : undefined}
            aria-describedby={fieldErrors.password
              ? "password-error"
              : undefined}
          />
          <FieldDescription
            >Mínimo 8 caracteres. Entrar en /login.</FieldDescription
          >
          {
            fieldErrors.password ? (
              <FieldError id="password-error">
                {fieldErrors.password}
              </FieldError>
            ) : null
          }
        </Field>
      </FieldGroup>
      <button class={buttonVariants()} type="submit">Crear cuenta</button>
    </form>
  </main>
</Layout>
