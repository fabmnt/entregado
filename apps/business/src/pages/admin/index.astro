---
import { buttonVariants } from "@workspace/ui/components/button"
import {
  Field,
  FieldDescription,
  FieldError,
  FieldGroup,
  FieldLabel,
} from "@workspace/ui/components/field"
import { Input } from "@workspace/ui/components/input"
import {
  NativeSelect,
  NativeSelectOption,
} from "@workspace/ui/components/native-select"
import { Textarea } from "@workspace/ui/components/textarea"
import Layout from "../../layouts/main.astro"
import {
  createBusiness,
  createBusinessSchema,
  fieldErrorsFromZod,
  listManagedBusinesses,
  type CreateFieldErrors,
} from "../../lib/businesses"
import {
  deleteUploadedImage,
  imageFieldError,
  isFilledFile,
  uploadImage,
} from "../../lib/images"

const KIND_OPTIONS = [
  { value: "food", label: "Comida" },
  { value: "pharmacy", label: "Farmacia" },
] as const

type FormValues = {
  slug: string
  name: string
  kind: string
  description: string
  advantages: string
  scope: string
  productPitch: string
  whatsapp: string
}

const emptyForm: FormValues = {
  slug: "",
  name: "",
  kind: "food",
  description: "",
  advantages: "",
  scope: "",
  productPitch: "",
  whatsapp: "",
}

let formValues = emptyForm
let fieldErrors: CreateFieldErrors = {}
let formError = ""

const token = Astro.locals.convexToken
const user = Astro.locals.user

if (!token || !user) {
  return Astro.redirect("/login", 303)
}

if (Astro.request.method === "POST") {
  const form = await Astro.request.formData()
  formValues = {
    slug: String(form.get("slug") ?? ""),
    name: String(form.get("name") ?? ""),
    kind: String(form.get("kind") ?? ""),
    description: String(form.get("description") ?? ""),
    advantages: String(form.get("advantages") ?? ""),
    scope: String(form.get("scope") ?? ""),
    productPitch: String(form.get("productPitch") ?? ""),
    whatsapp: String(form.get("whatsapp") ?? ""),
  }

  const logo = form.get("logo")
  let logoStorageId: Awaited<ReturnType<typeof uploadImage>> | undefined
  let skipCreate = false
  const parsed = createBusinessSchema.safeParse(formValues)
  if (!parsed.success) {
    formError = "Revisa los datos del negocio"
    fieldErrors = fieldErrorsFromZod<keyof CreateFieldErrors & string>(
      parsed.error
    )
    skipCreate = true
  } else if (isFilledFile(logo)) {
    const imageError = imageFieldError(logo)
    if (imageError) {
      formError = imageError
      fieldErrors = { logo: imageError }
      skipCreate = true
    } else {
      logoStorageId = await uploadImage(logo, token)
    }
  }

  if (parsed.success && !skipCreate) {
    const result = await createBusiness(parsed.data, token, logoStorageId)
    if (result.ok) {
      return Astro.redirect(`/admin/${result.business.slug}`, 303)
    }

    formError = result.error
    fieldErrors = result.fieldErrors
    if (logoStorageId) {
      const cleanedUp = await deleteUploadedImage(logoStorageId, token)
      if (!cleanedUp) {
        formError = `${formError}. No se pudo limpiar la imagen temporal.`
      }
    }
  }
}

const listed = await listManagedBusinesses(token)
const kindLabel = user.kind === "admin" ? "Admin general" : "Dueño de negocio"
---

<Layout title="Negocios | Entregado">
  <main class="mx-auto flex min-h-svh w-full max-w-lg flex-col gap-8 p-6">
    <header class="flex flex-col gap-3">
      <div class="flex items-start justify-between gap-4">
        <div class="flex flex-col gap-1">
          <h1 class="text-xl font-medium">Negocios</h1>
          <p class="text-sm text-muted-foreground">
            {user.email} · {kindLabel}
          </p>
        </div>
        <form method="post" action="/logout">
          <button class={buttonVariants({ variant: "ghost" })} type="submit">
            Salir
          </button>
        </form>
      </div>
      <p class="text-sm text-muted-foreground">
        {
          user.kind === "admin"
            ? "Ves todos los negocios del directorio."
            : "Ves los negocios que registraste."
        }
      </p>
    </header>

    {
      listed.length === 0 ? (
        <p class="text-sm text-muted-foreground">Todavía no hay negocios.</p>
      ) : (
        <ul class="flex flex-col gap-3">
          {listed.map((business) => (
            <li class="flex flex-col gap-0.5 border-b border-border pb-3">
              <a
                href={`/admin/${business.slug}`}
                class="text-sm font-medium underline-offset-4 hover:underline"
              >
                {business.name}
              </a>
              <span class="text-sm text-muted-foreground">
                {business.kind === "pharmacy" ? "Farmacia" : "Comida"} ·{" "}
                {business.slug}
              </span>
            </li>
          ))}
        </ul>
      )
    }

    <form
      method="post"
      enctype="multipart/form-data"
      class="flex flex-col gap-5"
    >
      <h2 class="text-sm font-medium">Nuevo negocio</h2>
      {
        formError ? (
          <p class="text-sm text-destructive" role="alert">
            {formError}
          </p>
        ) : null
      }
      <FieldGroup>
        <Field data-invalid={fieldErrors.name ? true : undefined}>
          <FieldLabel htmlFor="name">Nombre</FieldLabel>
          <Input
            id="name"
            name="name"
            defaultValue={formValues.name}
            required
            aria-invalid={fieldErrors.name ? true : undefined}
            aria-describedby={fieldErrors.name ? "name-error" : undefined}
          />
          {
            fieldErrors.name ? (
              <FieldError id="name-error">{fieldErrors.name}</FieldError>
            ) : null
          }
        </Field>
        <Field data-invalid={fieldErrors.slug ? true : undefined}>
          <FieldLabel htmlFor="slug">Slug</FieldLabel>
          <Input
            id="slug"
            name="slug"
            defaultValue={formValues.slug}
            required
            aria-invalid={fieldErrors.slug ? true : undefined}
            aria-describedby={fieldErrors.slug ? "slug-error" : undefined}
          />
          <FieldDescription>
            Dirección de la tienda: /tu-slug. Solo minúsculas, números y
            guiones. No se puede cambiar después.
          </FieldDescription>
          {
            fieldErrors.slug ? (
              <FieldError id="slug-error">{fieldErrors.slug}</FieldError>
            ) : null
          }
        </Field>
        <Field data-invalid={fieldErrors.kind ? true : undefined}>
          <FieldLabel htmlFor="kind">Tipo</FieldLabel>
          <NativeSelect
            id="kind"
            name="kind"
            className="w-full"
            defaultValue={formValues.kind || "food"}
            required
            aria-invalid={fieldErrors.kind ? true : undefined}
            aria-describedby={fieldErrors.kind ? "kind-error" : undefined}
          >
            {
              KIND_OPTIONS.map((option) => (
                <NativeSelectOption key={option.value} value={option.value}>
                  {option.label}
                </NativeSelectOption>
              ))
            }
          </NativeSelect>
          {
            fieldErrors.kind ? (
              <FieldError id="kind-error">{fieldErrors.kind}</FieldError>
            ) : null
          }
        </Field>
        <Field data-invalid={fieldErrors.whatsapp ? true : undefined}>
          <FieldLabel htmlFor="whatsapp">WhatsApp</FieldLabel>
          <Input
            id="whatsapp"
            name="whatsapp"
            type="tel"
            inputMode="numeric"
            autoComplete="tel"
            defaultValue={formValues.whatsapp}
            required
            aria-invalid={fieldErrors.whatsapp ? true : undefined}
            aria-describedby={fieldErrors.whatsapp
              ? "whatsapp-error"
              : undefined}
          />
          <FieldDescription>8 dígitos de Nicaragua.</FieldDescription>
          {
            fieldErrors.whatsapp ? (
              <FieldError id="whatsapp-error">
                {fieldErrors.whatsapp}
              </FieldError>
            ) : null
          }
        </Field>
        <Field>
          <FieldLabel htmlFor="logo">Logo (opcional)</FieldLabel>
          <Input
            id="logo"
            name="logo"
            type="file"
            accept="image/jpeg,image/png,image/webp"
            aria-invalid={fieldErrors.logo ? true : undefined}
            aria-describedby={fieldErrors.logo ? "logo-error" : undefined}
          />
          <FieldDescription>JPG, PNG o WebP. Máximo 2 MB.</FieldDescription>
          {
            fieldErrors.logo ? (
              <FieldError id="logo-error">{fieldErrors.logo}</FieldError>
            ) : null
          }
        </Field>
        <Field data-invalid={fieldErrors.description ? true : undefined}>
          <FieldLabel htmlFor="description">Descripción</FieldLabel>
          <Textarea
            id="description"
            name="description"
            defaultValue={formValues.description}
            required
            aria-invalid={fieldErrors.description ? true : undefined}
            aria-describedby={fieldErrors.description
              ? "description-error"
              : undefined}
          />
          {
            fieldErrors.description ? (
              <FieldError id="description-error">
                {fieldErrors.description}
              </FieldError>
            ) : null
          }
        </Field>
        <Field data-invalid={fieldErrors.advantages ? true : undefined}>
          <FieldLabel htmlFor="advantages">Ventajas</FieldLabel>
          <Textarea
            id="advantages"
            name="advantages"
            defaultValue={formValues.advantages}
            required
            aria-invalid={fieldErrors.advantages ? true : undefined}
            aria-describedby={fieldErrors.advantages
              ? "advantages-error"
              : undefined}
          />
          {
            fieldErrors.advantages ? (
              <FieldError id="advantages-error">
                {fieldErrors.advantages}
              </FieldError>
            ) : null
          }
        </Field>
        <Field data-invalid={fieldErrors.scope ? true : undefined}>
          <FieldLabel htmlFor="scope">Alcance</FieldLabel>
          <Textarea
            id="scope"
            name="scope"
            defaultValue={formValues.scope}
            required
            aria-invalid={fieldErrors.scope ? true : undefined}
            aria-describedby={fieldErrors.scope ? "scope-error" : undefined}
          />
          <FieldDescription>
            Zona, horario o a quién llega el negocio. Sin mapa todavía.
          </FieldDescription>
          {
            fieldErrors.scope ? (
              <FieldError id="scope-error">{fieldErrors.scope}</FieldError>
            ) : null
          }
        </Field>
        <Field data-invalid={fieldErrors.productPitch ? true : undefined}>
          <FieldLabel htmlFor="productPitch">Qué vende</FieldLabel>
          <Textarea
            id="productPitch"
            name="productPitch"
            defaultValue={formValues.productPitch}
            required
            aria-invalid={fieldErrors.productPitch ? true : undefined}
            aria-describedby={fieldErrors.productPitch
              ? "product-pitch-error"
              : undefined}
          />
          <FieldDescription>
            Una frase de promoción. No listes el catálogo.
          </FieldDescription>
          {
            fieldErrors.productPitch ? (
              <FieldError id="product-pitch-error">
                {fieldErrors.productPitch}
              </FieldError>
            ) : null
          }
        </Field>
      </FieldGroup>
      <button class={buttonVariants()} type="submit">Guardar</button>
    </form>
  </main>
</Layout>
